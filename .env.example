# ============================================================
# RAG Technical Documentation Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Google Gemini API ────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model to use (change if newer version available)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048

# ── ChromaDB Vector Database ─────────────────────────────────
# Local persistent storage path for the vector database
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=technical_docs

# ── Embedding Model ──────────────────────────────────────────
# Uses HuggingFace sentence-transformers (downloaded automatically)
# all-MiniLM-L6-v2 is 90MB, excellent quality/speed tradeoff
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── Document Chunking ────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval Settings ───────────────────────────────────────
# Number of document chunks to retrieve per query
TOP_K_RETRIEVAL=5

# ── LangGraph Workflow ───────────────────────────────────────
# Maximum number of query rewrite retries before fallback
MAX_RETRIES=3

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Documents Directory ──────────────────────────────────────
# Path to local documents for ingestion
DOCS_DIR=./docs
